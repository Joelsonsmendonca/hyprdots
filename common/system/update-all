#!/bin/bash
echo "========================================"
echo "    ATUALIZAÇÃO DO SISTEMA E IA         "
echo "========================================"

echo ""
echo "-> Atualizando pacotes do Arch Linux..."
sudo pacman -Syu --noconfirm

echo ""
echo "-> Atualizando ferramentas de IA (ia.skills)..."
