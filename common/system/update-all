    cd "$HOME/.claude/skills/ia-skills" && git pull
else
    echo "ia.skills não encontrado."
fi

echo ""
echo "========================================"
echo " Atualização concluída com sucesso!"
echo "========================================"
read -p "Pressione ENTER para fechar..."
