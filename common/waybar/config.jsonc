{
    // Layout "ilhas": barra transparente, cada grupo de módulos é uma ilha
    // arredondada (fundo/borda em style.css). Desenho escolhido no canvas
    // "Waybar Redesign" (barra A + módulo de IA com vários provedores).
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 8, // espaço entre ilhas

    "modules-left": [
        "ext/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    // battery e backlight somem sozinhos se o hardware nao existir
    // (comportamento nativo do waybar) -- por isso o mesmo arquivo serve pro PC e pro notebook
    "modules-right": [
        "group/sys",
        "group/ai",
        "group/notif",
        "group/extras",
        "custom/power"
    ],

    // --- Ilhas (grupos) ---

    "group/sys": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "backlight", "battery", "pulseaudio"]
    },

    // Um chip por provedor de IA (scripts/ai-usage.py). Provedor desligado no
    // ai-usagebar some sozinho (texto vazio).
    "group/ai": {
        "orientation": "horizontal",
        "modules": ["custom/ai-cld", "custom/ai-ag"]
    },

    "group/notif": {
        "orientation": "horizontal",
        "modules": ["custom/notification", "custom/notif-count"]
    },

    "group/extras": {
        "orientation": "horizontal",
        "modules": ["tray", "custom/keybinds", "custom/update"]
    },

    // --- Módulos ---

    // Usamos ext/workspaces (protocolo ext-workspace-v1), NAO hyprland/workspaces.
    // Motivo: a config do Hyprland e Lua, e nesse modo o servidor rejeita os
    // dispatches em texto ("dispatch workspace 5" -> erro de sintaxe Lua). O
    // hyprland/workspaces clica mandando exatamente esse texto, entao clicar nao
    // faz nada. O ext/workspaces ativa o workspace pelo protocolo Wayland direto.
    // Só aparecem workspaces que existem: os vazios somem porque as regras em
    // hypr/conf/monitors.lua NÃO são persistent (o ext/workspaces não tem classe
    // CSS pra "vazio", então esconder pelo CSS não dá).
    "ext/workspaces": {
        "format": "{name}",
        "sort-by": "number",
        // all-outputs=false (padrão): cada barra mostra só os workspaces do SEU monitor.
        "all-outputs": false,
        // Clique: ext/workspaces ativa pelo protocolo (padrão "activate").
        // Rolagem: hyprctl na forma Lua (dispatch em texto clássico morre no parser
        // Lua). m+1/m-1 = próximo/anterior que existe NESTE monitor. É instantâneo
        // (~0,1s); a rolagem lenta antiga do ai-usagebar era porque ele ia na rede.
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })'"
    },

    "hyprland/window": {
        "format": "<span foreground='#7aa2f7' font_weight='bold'>{class}</span>  <span foreground='#565f89'>·</span>  {title}",
        "max-length": 60,
        "separate-outputs": true
    },

    "clock": {
        // Data em português: precisa do "locale" E do "L" no começo do formato (o fmt
        // só usa o locale em chrono com o especificador L; sem ele sai "Fri, 09 Oct").
        "locale": "pt_BR.UTF-8",
        "format": "{:L%H:%M  <span foreground='#565f89' font_weight='normal'>%a, %d %b</span>}",
        "tooltip-format": "<big>{:%A, %d de %B de %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "<span foreground='#7dcfff'>󰻠</span> {usage}%",
        "tooltip": true,
        "on-click": "kitty btop"
    },

    "memory": {
        "format": "<span foreground='#bb9af7'>󰍛</span> {used:0.1f}G",
        "tooltip": true
    },

    "backlight": {
        "format": "<span foreground='#e0af68'>󰃠</span> {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰂄 {capacity}%",
        "tooltip-format": "{timeTo}"
    },

    "pulseaudio": {
        "format": "<span foreground='#9ece6a'>{icon}</span> {volume}%",
        "format-muted": "<span foreground='#565f89'>󰖁</span> mudo",
        // Scroll usa o controle NATIVO do waybar (libpulse -> mesmo sink default
        // das teclas de volume via wpctl). Antes chamava `pamixer`, que NAO esta
        // instalado -> rolar o icone nao fazia nada e parecia "outro sistema".
        // max-volume 100 pra bater com o `-l 1` das teclas.
        "scroll-step": 5,
        "max-volume": 100,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        }
    },

    "custom/ai-cld": {
        "exec": "~/.config/waybar/scripts/ai-usage.py anthropic",
        "return-type": "json",
        "interval": 300,
        "signal": 13,
        "tooltip": true,
        // clique abre o Claude Code num kitty novo (caminho completo: o PATH da
        // unidade systemd da waybar pode não ter ~/.local/bin); direito = painel de uso
        "on-click": "kitty --title 'Claude Code' --directory ~ $HOME/.local/bin/claude",
        "on-click-right": "ai-usagebar-tui"
    },

    "custom/ai-ag": {
        "exec": "~/.config/waybar/scripts/ai-usage.py antigravity",
        "return-type": "json",
        "interval": 300,
        "signal": 13,
        "tooltip": true,
        // clique abre o agy (CLI do Antigravity); direito = painel de uso
        "on-click": "kitty --title 'Antigravity' --directory ~ $HOME/.local/bin/agy",
        "on-click-right": "ai-usagebar-tui"
    },

    // Sino + contador separados: o contador é um módulo próprio pra virar uma
    // pílula vermelha no CSS, e some quando é 0 (texto vazio esconde o módulo).
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂞",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂞",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/notif-count": {
        "tooltip": false,
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb | jq --unbuffered -c '{text: (if .text == \"0\" then \"\" else .text end), class: .class}'",
        "on-click": "swaync-client -t -sw",
        "escape": true
    },

    "tray": {
        "icon-size": 16,
        "spacing": 12
    },

    "custom/keybinds": {
        "format": "󰌌",
        "tooltip-format": "Ver atalhos do Hyprland",
        "on-click": "~/.config/hypr/scripts/show-keybinds.sh"
    },

    "custom/update": {
        "format": "󰚰",
        "tooltip-format": "Atualizar sistema e IA",
        "on-click": "kitty --title 'System Update' bash -c /home/joelson/.local/bin/update-all"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Menu de energia",
        "on-click": "~/.config/hypr/scripts/power-menu.sh"
    }
}
