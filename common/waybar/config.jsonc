{
    // Posição da barra (top, bottom, left, right)
    "layer": "top",
    "position": "top",
    "height": 40, // Altura da barra
    "spacing": 4, // Espaçamento entre módulos

    // Módulos da Esquerda
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],

    // Módulos do Centro
    "modules-center": [
        "clock"
    ],

    // Módulos da Direita
    // battery, backlight e bluetooth somem sozinhos se o hardware nao existir
    // (comportamento nativo do waybar) -- por isso o mesmo arquivo serve pro PC e pro notebook
    "modules-right": [
        "custom/keybinds",
        "idle_inhibitor",
        "bluetooth",
        "backlight",
        "cpu",
        "memory",
        "battery",
        "pulseaudio",
        "tray",
        "custom/power"
    ],

    // --- Configurações Detalhadas dos Módulos ---

    "hyprland/workspaces": {
        "format": "{icon} {id}",
        "on-click": "activate",
        "format-icons": {
            "default": "",
            "urgent": "",
            "active": ""
        },
        "persistent_workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "hyprland/window": {
        "format": "{}",
        "max-length": 35
    },

    "clock": {
        "format": " {:%H:%M}",
        "format-alt": " {:%d/%m/%Y}",
        "tooltip-format": "<big>{:%A, %d de %B de %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        },
        "tooltip": true
    },

    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "format-connected-battery": " {device_alias} {device_battery_percentage}%",
        "format-off": " Desligado",
        "format-disabled": " Desativado",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "rfkill toggle bluetooth"
    },

    "backlight": {
        "format": " {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": true,
        "on-click": "kitty btop"
    },

    "memory": {
        "format": " {used:0.1f}G",
        "tooltip": true
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "tooltip-format": "{timeTo}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " Mudo",
        "on-click": "pavucontrol",
        "on-scroll-up": "pamixer -i 5",   // Aumenta volume
        "on-scroll-down": "pamixer -d 5", // Diminui volume
        "scroll-step": 5,
        "format-icons": {
            "default": ["", ""]
        }
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "custom/keybinds": {
        "format": "",
        "tooltip-format": "Ver atalhos do Hyprland",
        "on-click": "~/.config/hypr/scripts/show-keybinds.sh"
    },

    "custom/power": {
        "format": "",
        "tooltip-format": "Menu de energia",
        "on-click": "~/.config/hypr/scripts/power-menu.sh"
    }
}
